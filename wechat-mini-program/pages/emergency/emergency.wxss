.page {
  width: 100vw;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

/* 头部 */
.header {
  background-color: #c41e3a;
  color: white;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header .title {
  font-size: 32rpx;
  font-weight: bold;
}

/* 内容区 */
.content {
  padding: 20rpx;
}

/* 紧急求助按钮 */
.emergency-button {
  width: 100%;
  height: 300rpx;
  background-color: #c41e3a;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 30rpx;
}
.button-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.button-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.button-subtext {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 紧急联系电话 */
.contact-list {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}
.contact-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}
.contact-item:last-child {
  border-bottom: none;
}
.contact-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  color: #c41e3a;
}
.contact-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
}
.contact-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #c41e3a;
}

/* 健康档案 */
.health-record {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}
.health-info {
  display: flex;
  margin-bottom: 15rpx;
}
.health-label {
  width: 100rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
}
.health-value {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
}
.edit-btn {
  background-color: #c41e3a;
  color: white;
  border: none;
  border-radius: 4rpx;
  padding: 15rpx 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

/* 救援记录 */
.rescue-record {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}
.record-item {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}
.record-date {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.record-content {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.record-status {
  font-size: 20rpx;
  color: #c41e3a;
  font-weight: bold;
}

/* 通用样式 */
.gray-text {
  color: #666;
}