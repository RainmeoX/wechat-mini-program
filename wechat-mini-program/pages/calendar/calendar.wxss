.page {
  width: 100vw;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

/* 头部 */
.header {
  background-color: #c41e3a;
  color: white;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header .title {
  font-size: 32rpx;
  font-weight: bold;
}
.header-buttons {
  display: flex;
  gap: 10rpx;
}
.view-btn, .filter-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
  border: none;
  border-radius: 4rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 内容区 */
.content {
  padding: 20rpx;
}

/* 列表视图 */
.list-view {
  margin-bottom: 30rpx;
}
.timeline {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}
.timeline-item {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}
.timeline-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}
.timeline-date {
  width: 120rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-right: 20rpx;
}
.timeline-content {
  flex: 1;
}
.timeline-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.timeline-desc {
  font-size: 24rpx;
  color: #666;
}

/* 海报视图 */
.poster-view {
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.poster-item {
  width: calc(50% - 10rpx);
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.poster-image {
  width: 100%;
  height: 150rpx;
  background-color: #c41e3a;
  border-radius: 4rpx;
  margin-bottom: 15rpx;
}
.poster-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 10rpx;
}
.poster-date {
  font-size: 24rpx;
  color: #666;
}

/* 提醒设置 */
.reminder-setting {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}
.reminder-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}
.reminder-options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.reminder-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}
.reminder-option:last-child {
  border-bottom: none;
}
.reminder-option text {
  font-size: 24rpx;
  font-weight: bold;
}

/* 通用样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}