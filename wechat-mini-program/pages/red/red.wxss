.page {
  width: 100vw;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
}

/* 头部 */
.header {
  background-color: #c41e3a;
  color: white;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header .title {
  font-size: 32rpx;
  font-weight: bold;
}
.header-buttons {
  display: flex;
  gap: 10rpx;
}
.mode-btn, .voice-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
  border: none;
  border-radius: 4rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 内容区 */
.content {
  padding: 20rpx;
}

/* 视频播放区 */
.video-container {
  margin-bottom: 30rpx;
}
.video-placeholder {
  width: 100%;
  height: 300rpx;
  background-color: #c41e3a;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}
.play-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.video-title {
  font-size: 28rpx;
  font-weight: bold;
}

/* 红色故事列表 */
.story-list {
  margin-bottom: 30rpx;
}
.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}
.story-item {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}
.story-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-right: 20rpx;
  width: 60rpx;
}
.story-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
}
.story-duration {
  font-size: 24rpx;
  color: #666;
}

/* 红色资源导览 */
.navigation-section {
  margin-bottom: 30rpx;
}
.map-placeholder {
  width: 100%;
  height: 200rpx;
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #c41e3a;
  border: 1px solid #c41e3a;
}
.map-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}
.map-text {
  font-size: 24rpx;
  font-weight: bold;
}

/* 学习激励 */
.incentive-section {
  margin-bottom: 30rpx;
}
.incentive-content {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.points, .check-in {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.points-label, .check-in-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.points-value, .check-in-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #c41e3a;
}
.check-in-btn {
  background-color: #c41e3a;
  color: white;
  border: none;
  border-radius: 4rpx;
  padding: 15rpx 30rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 通用样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}