<view class="page">
  <view class="header">
    <text class="title">红色广益</text>
    <view class="header-buttons">
      <button class="mode-btn" bind:tap="toggleMode">长辈模式</button>
      <button class="voice-btn" bind:tap="toggleVoice">语音播报</button>
    </view>
  </view>
  <view class="content">
    <!-- 搜索框 -->
    <view class="search-bar">
      <input class="search-input" placeholder="搜索红色资源" />
      <button class="search-btn">搜索</button>
    </view>
    
    <!-- 资源分区 -->
    <view class="resource-sections">
      <!-- 红色旧址 -->
      <view class="section">
        <text class="section-title">红色旧址</text>
        <view class="resource-list">
          <view class="resource-item" bind:tap="viewResource">
            <view class="resource-image"></view>
            <text class="resource-name">革命纪念馆</text>
            <text class="resource-desc">了解革命历史</text>
          </view>
          <view class="resource-item" bind:tap="viewResource">
            <view class="resource-image"></view>
            <text class="resource-name">烈士纪念碑</text>
            <text class="resource-desc">缅怀革命先烈</text>
          </view>
        </view>
      </view>
      
      <!-- 红色活动 -->
      <view class="section">
        <text class="section-title">红色活动</text>
        <view class="resource-list">
          <view class="resource-item" bind:tap="viewResource">
            <view class="resource-image"></view>
            <text class="resource-name">红色主题党日</text>
            <text class="resource-desc">每月第一个周五</text>
          </view>
          <view class="resource-item" bind:tap="viewResource">
            <view class="resource-image"></view>
            <text class="resource-name">红色宣讲会</text>
            <text class="resource-desc">每周六下午</text>
          </view>
        </view>
      </view>
      
      <!-- 红色教育 -->
      <view class="section">
        <text class="section-title">红色教育</text>
        <view class="resource-list">
          <view class="resource-item" bind:tap="viewResource">
            <view class="resource-image"></view>
            <text class="resource-name">红色课堂</text>
            <text class="resource-desc">每周日上午</text>
          </view>
          <view class="resource-item" bind:tap="viewResource">
            <view class="resource-image"></view>
            <text class="resource-name">红色书籍</text>
            <text class="resource-desc">免费借阅</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>