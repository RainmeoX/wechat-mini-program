page {
  background: #f8f8f8;
  margin: 0;
  padding: 0;
  font-family: PingFang SC, Microsoft YaHei, SimSun;
}

/* 红色政务类通用样式 */
.red-bg {
  background-color: #c41e3a;
}

.red-text {
  color: #c41e3a;
}

.white-text {
  color: white;
}

.gray-text {
  color: #666;
}

.border-red {
  border: 1px solid #c41e3a;
}

.btn-primary {
  background-color: #c41e3a;
  color: white;
  border-radius: 4rpx;
  padding: 15rpx 30rpx;
}

.btn-secondary {
  background-color: white;
  color: #c41e3a;
  border: 1px solid #c41e3a;
  border-radius: 4rpx;
  padding: 15rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #c41e3a;
}

.card {
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  margin-bottom: 20rpx;
}